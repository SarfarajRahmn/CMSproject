# Server Configuration
PORT=8080
NODE_ENV=development

# Cloudinary Image Hosting Configuration
# Replace these with your credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional PostgreSQL Database Configuration (e.g. Neon.tech, Supabase, local PostgreSQL)
# If not provided, the application automatically uses local JSON storage (data/articles.json).
# PGHOST=your-neon-host.aws.neon.tech
# PGDATABASE=neondb
# PGUSER=your_db_user
# PGPASSWORD=your_db_password
# PGPORT=5432
# PGSSL=true
# Or full connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

