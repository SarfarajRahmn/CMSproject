<%- include('partials/header', { title: article ? article.title : 'Article Details' }) %>
<%- include('partials/navbar', { page: 'articles' }) %>

<main class="container my-5">
  <% if (typeof article !== 'undefined' && article) { %>
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a href="/articles" class="text-decoration-none">Articles</a></li>
        <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page"><%= article.title %></li>
      </ol>
    </nav>

    <div class="row justify-content-center">
      <div class="col-lg-9">
        <article class="bg-white p-4 p-md-5 rounded-4 shadow-sm border">
          <!-- Category & Status -->
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <span class="badge-category badge-cat-<%= (article.category || 'general').toLowerCase() %>">
              <i class="fa-solid fa-tag"></i> <%= article.categoryName || article.category %>
            </span>
            <div class="d-flex align-items-center gap-2">
              <% if (article.published) { %>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Published</span>
              <% } else { %>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">Draft</span>
              <% } %>
            </div>
          </div>

          <!-- Title -->
          <h1 class="display-6 fw-bold mb-3"><%= article.title %></h1>

          <!-- Author & Meta -->
          <div class="d-flex align-items-center gap-3 py-3 mb-4 border-top border-bottom text-muted">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-weight: 700;">
              <%= (article.author || 'A').charAt(0).toUpperCase() %>
            </div>
            <div>
              <div class="fw-bold text-dark"><%= article.author || 'MD ARAFAT KOYES' %></div>
              <small><i class="fa-regular fa-calendar me-1"></i> Published on <%= article.articleDate || 'Recently' %></small>
            </div>
          </div>

          <!-- Feature Image -->
          <% if (article.featureImage) { %>
            <div class="text-center mb-4 overflow-hidden rounded-3 bg-light">
              <img
                src="<%= article.featureImage %>"
                alt="<%= article.title %>"
                class="img-fluid rounded-3"
                style="max-height: 420px; width: 100%; object-fit: cover;"
                onerror="this.src='/images/CONTENT.png'"
              />
            </div>
          <% } %>

          <!-- Content Body -->
          <div class="article-content fs-5 lh-lg text-secondary mb-5" style="white-space: pre-line;">
            <%= article.content %>
          </div>

          <!-- Footer Actions -->
          <div class="d-flex flex-wrap justify-content-between align-items-center pt-4 border-top gap-3">
            <a href="/articles" class="btn btn-outline-secondary">
              <i class="fa-solid fa-arrow-left me-1"></i> Back to Articles
            </a>
            <div class="d-flex gap-2">
              <a href="/articles/edit/<%= article.id %>" class="btn btn-outline-primary">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Article
              </a>
              <form method="POST" action="/articles/delete/<%= article.id %>" onsubmit="return confirm('Are you sure you want to delete this article?');">
                <button type="submit" class="btn btn-outline-danger">
                  <i class="fa-solid fa-trash me-1"></i> Delete
                </button>
              </form>
            </div>
          </div>
        </article>
      </div>
    </div>
  <% } else { %>
    <div class="text-center py-5">
      <div class="p-5 bg-white rounded-4 shadow-sm">
        <i class="fa-solid fa-file-circle-question fa-3x text-muted mb-3"></i>
        <h3>Article Not Found</h3>
        <p class="text-muted">The requested article does not exist or may have been removed.</p>
        <a href="/articles" class="btn btn-primary-custom mt-2">
          <i class="fa-solid fa-arrow-left me-1"></i> Return to Articles List
        </a>
      </div>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
