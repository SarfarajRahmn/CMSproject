<%- include('partials/header', { title: course.title }) %>
<%- include('partials/navbar', { page: 'courses' }) %>

<main class="container my-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/courses" class="text-decoration-none">Courses</a></li>
      <li class="breadcrumb-item active text-truncate" style="max-width: 320px;" aria-current="page"><%= course.title %></li>
    </ol>
  </nav>

  <div class="row g-5">
    <!-- Main Content Area -->
    <div class="col-lg-8">
      <!-- Course Header -->
      <div class="mb-4">
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
          <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1.5 rounded-pill fw-semibold">
            <%= course.category %>
          </span>
          <span class="badge bg-secondary-subtle text-secondary px-3 py-1.5 rounded-pill fw-semibold">
            <i class="fa-solid fa-signal me-1"></i><%= course.level %>
          </span>
          <% if (course.badge) { %>
            <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill fw-bold">
              <i class="fa-solid fa-bolt me-1"></i><%= course.badge %>
            </span>
          <% } %>
        </div>

        <h1 class="display-6 fw-bold mb-3"><%= course.title %></h1>
        <p class="lead text-secondary mb-3"><%= course.subtitle %></p>

        <!-- Social Proof Stats -->
        <div class="d-flex flex-wrap align-items-center gap-3 small text-muted">
          <div class="d-flex align-items-center gap-1">
            <span class="text-warning"><i class="fa-solid fa-star"></i></span>
            <strong class="text-dark"><%= course.rating || 4.9 %></strong>
            <span>(<%= course.reviewsCount || 120 %> student ratings)</span>
          </div>
          <div>&bull;</div>
          <div><i class="fa-solid fa-users me-1 text-primary"></i><%= (course.enrolledCount || 0).toLocaleString() %> students enrolled</div>
          <div>&bull;</div>
          <div><i class="fa-regular fa-clock me-1"></i><%= course.duration %></div>
        </div>
      </div>

      <!-- Instructor Info Header -->
      <div class="card p-3 border-0 bg-light rounded-4 mb-4">
        <div class="d-flex align-items-center gap-3">
          <img
            src="<%= course.instructor ? course.instructor.avatar : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80' %>"
            alt="<%= course.instructor ? course.instructor.name : 'Instructor' %>"
            class="rounded-circle shadow-sm"
            style="width: 55px; height: 55px; object-fit: cover;"
          />
          <div>
            <div class="small text-muted">Created & Instructed by</div>
            <h6 class="fw-bold mb-0 text-dark"><%= course.instructor ? course.instructor.name : 'Sarfaraj Rahman' %></h6>
            <div class="small text-secondary"><%= course.instructor ? course.instructor.title : 'Senior Engineer & Educator' %></div>
          </div>
        </div>
      </div>

      <!-- What You'll Learn -->
      <section class="card p-4 border rounded-4 shadow-sm mb-5">
        <h4 class="fw-bold mb-3"><i class="fa-solid fa-check-double text-success me-2"></i>What You'll Learn</h4>
        <div class="row g-3">
          <% if (course.highlights && course.highlights.length > 0) { %>
            <% course.highlights.forEach(highlight => { %>
              <div class="col-md-6">
                <div class="d-flex align-items-start gap-2">
                  <i class="fa-solid fa-circle-check text-success mt-1"></i>
                  <span class="text-secondary"><%= highlight %></span>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="col-12 text-muted">Comprehensive hands-on training with production projects.</div>
          <% } %>
        </div>
      </section>

      <!-- Curriculum Syllabus Accordion -->
      <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="fw-bold mb-0">Course Content & Curriculum</h4>
          <span class="text-muted small"><%= course.syllabus ? course.syllabus.length : 0 %> Modules &bull; <%= course.lessonsCount %> Lectures</span>
        </div>

        <div class="accordion syllabus-accordion shadow-sm rounded-4 overflow-hidden" id="syllabusAccordion">
          <% if (course.syllabus && course.syllabus.length > 0) { %>
            <% course.syllabus.forEach((mod, idx) => { %>
              <div class="accordion-item border-0 border-bottom">
                <h2 class="accordion-header" id="heading<%= idx %>">
                  <button
                    class="accordion-button <%= idx === 0 ? '' : 'collapsed' %> py-3"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapse<%= idx %>"
                    aria-expanded="<%= idx === 0 ? 'true' : 'false' %>"
                    aria-controls="collapse<%= idx %>"
                  >
                    <i class="fa-solid fa-layer-group me-2 text-primary"></i>
                    <strong><%= mod.module || ('Module ' + (idx + 1)) %></strong>
                    <span class="ms-auto text-muted small me-3"><%= mod.lessons ? mod.lessons.length : 0 %> lessons</span>
                  </button>
                </h2>
                <div
                  id="collapse<%= idx %>"
                  class="accordion-collapse collapse <%= idx === 0 ? 'show' : '' %>"
                  aria-labelledby="heading<%= idx %>"
                  data-bs-parent="#syllabusAccordion"
                >
                  <div class="accordion-body p-3 bg-white">
                    <ul class="list-unstyled mb-0">
                      <% if (mod.lessons && mod.lessons.length > 0) { %>
                        <% mod.lessons.forEach((lesson, lIdx) => { %>
                          <li class="lesson-list-item">
                            <div>
                              <i class="fa-regular fa-circle-play text-primary me-2"></i>
                              <span><%= lesson %></span>
                            </div>
                            <span class="badge bg-light text-secondary border">Video</span>
                          </li>
                        <% }); %>
                      <% } %>
                    </ul>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="p-4 bg-white text-muted">Curriculum details available upon enrollment.</div>
          <% } %>
        </div>
      </section>

      <!-- Requirements & Target Audience -->
      <section class="card p-4 border rounded-4 shadow-sm mb-5">
        <h4 class="fw-bold mb-3"><i class="fa-solid fa-list-check text-primary me-2"></i>Requirements</h4>
        <ul class="mb-0 text-secondary ps-3">
          <li class="mb-2">A computer (Windows, Mac, or Linux) with internet access.</li>
          <li class="mb-2">No prior advanced experience required; we guide you step-by-step from foundations to advanced topics.</li>
          <li>Enthusiasm and commitment to build real applications!</li>
        </ul>
      </section>
    </div>

    <!-- Sticky Sidebar Purchase Box -->
    <div class="col-lg-4">
      <div class="enroll-card-sticky">
        <div class="position-relative">
          <img
            src="<%= course.thumbnail || '/images/CONTENT.png' %>"
            alt="<%= course.title %>"
            class="w-100"
            style="height: 220px; object-fit: cover;"
            onerror="this.src='/images/CONTENT.png'"
          />
        </div>

        <div class="p-4">
          <!-- Pricing -->
          <div class="d-flex align-items-baseline gap-2 mb-2">
            <span class="display-6 fw-bold text-success">$<%= course.price %></span>
            <% if (course.originalPrice && course.originalPrice > course.price) { %>
              <span class="text-decoration-line-through text-muted fs-5">$<%= course.originalPrice %></span>
              <span class="badge bg-danger ms-auto">
                Save <%= Math.round((1 - course.price / course.originalPrice) * 100) %>%
              </span>
            <% } %>
          </div>

          <div class="text-danger small fw-semibold mb-3">
            <i class="fa-solid fa-hourglass-half me-1"></i> Special introductory price ends soon!
          </div>

          <!-- CTA Buttons -->
          <button
            type="button"
            class="btn btn-primary-custom btn-lg w-100 mb-2 py-3 fw-bold"
            onclick="openEnrollModal(<%= course.id %>, '<%= course.title.replace(/'/g, "\\'") %>', <%= course.price %>)"
          >
            <i class="fa-solid fa-cart-shopping me-2"></i> Enroll in Course
          </button>
          
          <div class="text-center small text-muted mb-4">
            <i class="fa-solid fa-shield-halved text-success me-1"></i> 30-Day Money-Back Guarantee
          </div>

          <!-- Course Features Checklist -->
          <div class="border-top pt-3">
            <h6 class="fw-bold mb-3">This course includes:</h6>
            <ul class="list-unstyled small text-secondary mb-0">
              <li class="mb-2"><i class="fa-solid fa-video text-primary me-2"></i> <%= course.duration %> on-demand video</li>
              <li class="mb-2"><i class="fa-solid fa-file-code text-primary me-2"></i> Real-world portfolio projects</li>
              <li class="mb-2"><i class="fa-solid fa-infinity text-primary me-2"></i> Full lifetime access</li>
              <li class="mb-2"><i class="fa-solid fa-mobile-screen text-primary me-2"></i> Access on mobile, tablet & desktop</li>
              <li class="mb-2"><i class="fa-solid fa-certificate text-primary me-2"></i> Certificate of Completion</li>
              <li><i class="fa-solid fa-comments text-primary me-2"></i> Instructor Q&A community access</li>
            </ul>
          </div>

          <!-- Management Actions -->
          <div class="border-top mt-4 pt-3 d-flex justify-content-between">
            <a href="/courses/edit/<%= course.id %>" class="btn btn-sm btn-outline-secondary">
              <i class="fa-solid fa-pen me-1"></i> Edit Course
            </a>
            <form action="/courses/delete/<%= course.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this course?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="fa-solid fa-trash me-1"></i> Delete
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Quick Enroll Modal -->
<div class="modal fade" id="enrollModal" tabindex="-1" aria-labelledby="enrollModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="modal-header bg-dark-navy text-white border-0 py-3">
        <h5 class="modal-title fw-bold" id="enrollModalLabel">
          <i class="fa-solid fa-cart-shopping me-2 text-warning"></i> Complete Your Enrollment
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/courses/enroll" method="POST">
        <input type="hidden" id="modalCourseId" name="courseId" value="<%= course.id %>" />
        <div class="modal-body p-4">
          <div class="p-3 bg-light rounded-3 mb-3 border">
            <div class="small text-muted">Selected Course:</div>
            <h6 class="fw-bold mb-1 text-primary" id="modalCourseTitle"><%= course.title %></h6>
            <div class="d-flex justify-content-between align-items-center mt-2">
              <span class="text-muted small">Total Investment:</span>
              <span class="fw-bold fs-5 text-success" id="modalCoursePrice">$<%= course.price %></span>
            </div>
          </div>

          <div class="mb-3">
            <label for="studentName" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="studentName" name="studentName" placeholder="Enter your full name" required />
          </div>

          <div class="mb-3">
            <label for="studentEmail" class="form-label fw-bold">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control" id="studentEmail" name="studentEmail" placeholder="you@example.com" required />
            <small class="text-muted">Your course access link and receipt will be delivered here.</small>
          </div>

          <div class="mb-3">
            <label for="studentPhone" class="form-label fw-bold">Phone Number (optional)</label>
            <input type="text" class="form-control" id="studentPhone" name="studentPhone" placeholder="+1 (555) 000-0000" />
          </div>

          <div class="mb-3">
            <label for="paymentMethod" class="form-label fw-bold">Payment Method</label>
            <select class="form-select" id="paymentMethod" name="paymentMethod">
              <option value="Credit / Debit Card">Credit / Debit Card (Stripe)</option>
              <option value="PayPal">PayPal</option>
              <option value="Mobile Banking">Mobile Banking (bKash / Nagad / Rocket)</option>
            </select>
          </div>

          <div class="p-2 bg-success bg-opacity-10 rounded-2 text-success small">
            <i class="fa-solid fa-shield-check me-1"></i> 30-Day 100% Money-Back Satisfaction Guarantee.
          </div>
        </div>
        <div class="modal-footer border-0 pt-0 pb-4 px-4">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-custom btn-lg w-100 mt-2">
            <i class="fa-solid fa-lock me-2"></i> Confirm Enrollment & Pay ($<%= course.price %>)
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openEnrollModal(courseId, title, price) {
    document.getElementById('modalCourseId').value = courseId;
    document.getElementById('modalCourseTitle').textContent = title;
    document.getElementById('modalCoursePrice').textContent = '$' + price;
    const modal = new bootstrap.Modal(document.getElementById('enrollModal'));
    modal.show();
  }
</script>

<%- include('partials/footer') %>
