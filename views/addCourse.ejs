<%- include('partials/header', { title: 'Add New Course' }) %>
<%- include('partials/navbar', { page: 'courses' }) %>

<main class="container my-4 my-md-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/courses" class="text-decoration-none">Courses</a></li>
      <li class="breadcrumb-item active" aria-current="page">Publish New Course</li>
    </ol>
  </nav>

  <div class="row g-4">
    <!-- Main Form Column -->
    <div class="col-lg-8">
      <div class="form-card">
        <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3 flex-wrap gap-2">
          <div>
            <h2 class="h3 fw-bold mb-1">
              <i class="fa-solid fa-graduation-cap text-primary me-2"></i> Publish a New Course
            </h2>
            <p class="text-muted small mb-0">Create and list a new course with Bangladesh (৳ BDT) pricing and curriculum.</p>
          </div>
          <a href="/courses" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-xmark me-1"></i> বাতিল
          </a>
        </div>

        <form action="/courses/add" method="POST" enctype="multipart/form-data" id="addCourseForm" onsubmit="return handleFormSubmit(event)">
          <!-- Course Title -->
          <div class="mb-3">
            <label for="title" class="form-label fw-bold">Course Title <span class="text-danger">*</span></label>
            <input
              type="text"
              class="form-control"
              id="title"
              name="title"
              placeholder="e.g. Modern Full-Stack Web Development Bootcamp (MERN & Next.js)"
              required
              oninput="updateLivePreview()"
            />
          </div>

          <!-- Subtitle -->
          <div class="mb-3">
            <label for="subtitle" class="form-label fw-bold">Short Subtitle / Description <span class="text-danger">*</span></label>
            <textarea
              class="form-control"
              id="subtitle"
              name="subtitle"
              rows="2"
              placeholder="HTML5, CSS3, JavaScript ES6+, React, Node.js দিয়ে ইন্ডাস্ট্রি-স্ট্যান্ডার্ড প্রজেক্ট তৈরি শিখুন..."
              required
              oninput="updateLivePreview()"
            ></textarea>
          </div>

          <!-- Category, Level, Badge Row -->
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label for="category" class="form-label fw-bold">Category <span class="text-danger">*</span></label>
              <select class="form-select" id="category" name="category" required onchange="updateLivePreview()">
                <option value="Web Development" selected>Web Development</option>
                <option value="AI & Machine Learning">AI & Machine Learning</option>
                <option value="Database & SQL">Database & SQL</option>
                <option value="Cloud & DevOps">Cloud & DevOps</option>
                <option value="Mobile Development">Mobile Development</option>
                <option value="Cybersecurity">Cybersecurity</option>
              </select>
            </div>
            <div class="col-md-4">
              <label for="level" class="form-label fw-bold">Difficulty Level</label>
              <select class="form-select" id="level" name="level" onchange="updateLivePreview()">
                <option value="All Levels">All Levels</option>
                <option value="Beginner to Advanced" selected>Beginner to Advanced</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
              </select>
            </div>
            <div class="col-md-4">
              <label for="badge" class="form-label fw-bold">Promotional Badge</label>
              <select class="form-select" id="badge" name="badge" onchange="updateLivePreview()">
                <option value="New" selected>New</option>
                <option value="Bestseller">Bestseller</option>
                <option value="Hot">Hot & Trending</option>
                <option value="Popular">Popular</option>
                <option value="">None</option>
              </select>
            </div>
          </div>

          <!-- Bangladesh Pricing & Duration Row with Live Calculator -->
          <div class="card p-3 bg-light border rounded-3 mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="fw-bold text-dark small">
                <i class="fa-solid fa-bangladeshi-taka-sign text-success me-1"></i> বাংলাদেশ বেসড কোর্স ফি ও প্রাইসিং (BDT ৳)
              </span>
              <span id="reactiveDiscountBadge" class="discount-live-pill d-none">
                <i class="fa-solid fa-tag"></i> <span id="discountValueText">0% ছাড়</span>
              </span>
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label for="price" class="form-label small fw-bold">কোর্স ফি / Offer Price (৳ BDT) <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-white fw-bold text-success">৳</span>
                  <input
                    type="number"
                    step="50"
                    min="0"
                    class="form-control fw-bold fs-6 text-success"
                    id="price"
                    name="price"
                    placeholder="4500"
                    value="4500"
                    required
                    oninput="recalculatePricing(); updateLivePreview();"
                  />
                  <span class="input-group-text bg-white text-muted small">BDT</span>
                </div>
                <div class="form-text small">শিক্ষার্থী এই পরিমাণ ফি প্রদান করবে।</div>
              </div>

              <div class="col-md-6">
                <label for="originalPrice" class="form-label small fw-bold">আসল মূল্য / List Price (৳ BDT)</label>
                <div class="input-group">
                  <span class="input-group-text bg-white fw-bold text-muted">৳</span>
                  <input
                    type="number"
                    step="50"
                    min="0"
                    class="form-control text-secondary"
                    id="originalPrice"
                    name="originalPrice"
                    placeholder="8500"
                    value="8500"
                    oninput="recalculatePricing(); updateLivePreview();"
                  />
                  <span class="input-group-text bg-white text-muted small">BDT</span>
                </div>
                <div class="form-text small">ছাড় দেখানোর জন্য নিয়মিত ফি দিন।</div>
              </div>

              <div class="col-md-6">
                <label for="duration" class="form-label small fw-bold">কোর্সের মেয়াদ / Duration</label>
                <div class="input-group">
                  <span class="input-group-text bg-white text-muted"><i class="fa-regular fa-clock"></i></span>
                  <input
                    type="text"
                    class="form-control"
                    id="duration"
                    name="duration"
                    placeholder="e.g. 12 Weeks (50+ Hours)"
                    value="12 Weeks (50+ Hours)"
                    oninput="updateLivePreview()"
                  />
                </div>
              </div>

              <div class="col-md-6">
                <label for="lessonsCount" class="form-label small fw-bold">মোট লেকচার সংখ্যা</label>
                <div class="input-group">
                  <span class="input-group-text bg-white text-muted"><i class="fa-solid fa-play"></i></span>
                  <input
                    type="number"
                    class="form-control"
                    id="lessonsCount"
                    name="lessonsCount"
                    placeholder="e.g. 64"
                    value="60"
                    oninput="updateLivePreview()"
                  />
                </div>
              </div>
            </div>

            <!-- Savings Banner -->
            <div id="savingsNotice" class="mt-3 p-2.5 rounded-2 bg-success bg-opacity-10 border border-success border-opacity-25 small text-success">
              <i class="fa-solid fa-circle-check me-1"></i> শিক্ষার্থী সাশ্রয় করবে: 
              <strong id="savingsAmountText">৳৪,০০০</strong> (<strong id="savingsPercentText">৪৭%</strong> ডিসকাউন্ট)
            </div>
            <div id="pricingWarning" class="mt-3 p-2 rounded-2 bg-warning bg-opacity-10 border border-warning text-dark small d-none">
              <i class="fa-solid fa-triangle-exclamation text-warning me-1"></i> অফার মূল্য আসল মূল্যের চেয়ে বেশি হতে পারবে না।
            </div>
          </div>

          <!-- Instructor Information Row -->
          <div class="card p-3 bg-light border rounded-3 mb-3">
            <span class="fw-bold text-dark small mb-2 d-block">
              <i class="fa-solid fa-chalkboard-user text-primary me-1"></i> কোর্স শিক্ষক / মেন্টর ইনফরমেশন
            </span>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="instructorName" class="form-label small fw-bold">ইন্সট্রাক্টরের নাম</label>
                <input
                  type="text"
                  class="form-control"
                  id="instructorName"
                  name="instructorName"
                  placeholder="e.g. Sarfaraj Rahman"
                  value="Sarfaraj Rahman"
                  oninput="updateLivePreview()"
                />
              </div>
              <div class="col-md-6">
                <label for="instructorTitle" class="form-label small fw-bold">পদবি / পেশা</label>
                <input
                  type="text"
                  class="form-control"
                  id="instructorTitle"
                  name="instructorTitle"
                  placeholder="e.g. Senior Full-Stack Engineer & Cloud Architect"
                  value="Senior Full-Stack Engineer"
                  oninput="updateLivePreview()"
                />
              </div>
            </div>
          </div>

          <!-- Thumbnail Upload -->
          <div class="mb-3">
            <label for="featureImage" class="form-label fw-bold">Course Thumbnail</label>
            <input
              type="file"
              class="form-control"
              id="featureImage"
              name="featureImage"
              accept="image/*"
              onchange="previewCourseThumbnail(this)"
            />
            <div id="courseThumbnailPreviewContainer" class="mt-2 d-none text-center p-2 bg-light rounded-3 border">
              <img id="courseThumbnailPreview" src="#" alt="Preview" class="img-fluid rounded" style="max-height: 200px;" />
            </div>
          </div>

          <!-- Highlights -->
          <div class="mb-3">
            <label for="highlights" class="form-label fw-bold">কোর্সের মূল আকর্ষণসমূহ (Highlights - প্রতি লাইনে একটি)</label>
            <textarea
              class="form-control font-monospace small"
              id="highlights"
              name="highlights"
              rows="4"
              placeholder="৮টি ইন্ডাস্ট্রি-স্ট্যান্ডার্ড প্রজেক্ট পোর্টফোলিও&#10;মডার্ন JavaScript ES6+, React ও Node.js API&#10;পোস্টগ্রেসকিউএল ডাটাবেস ডিজাইন ও সিকিউরিটি&#10;লাইভ মেন্টরিং, সিভি রিভিউ ও জব ইন্টারভিউ প্রস্তুতি"
            ></textarea>
          </div>

          <!-- Syllabus / Curriculum -->
          <div class="mb-4">
            <label for="syllabus" class="form-label fw-bold">কারিকুলাম লেকচার তালিকা (Syllabus Lessons - প্রতি লাইনে একটি)</label>
            <textarea
              class="form-control font-monospace small"
              id="syllabus"
              name="syllabus"
              rows="6"
              placeholder="Module 1: Web Foundations & Modern Layouts&#10;Module 2: Advanced JavaScript (ES6+) & DOM&#10;Module 3: Server Architecture with Express & Node.js&#10;Module 4: PostgreSQL Databases & Cloud Production Deployment"
            ></textarea>
          </div>

          <!-- Published Switch -->
          <div class="mb-4 p-3 bg-light rounded-3 border">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="published" name="published" checked onchange="updateLivePreview()" />
              <label class="form-check-label fw-semibold" for="published">
                কোর্সটি তৈরি করার সাথে সাথে ক্যাটালগে লাইভ পাবলিশ করুন
              </label>
            </div>
          </div>

          <!-- Submit Buttons -->
          <div class="d-flex justify-content-end gap-2 flex-wrap">
            <a href="/courses" class="btn btn-secondary-custom">বাতিল</a>
            <button type="submit" class="btn btn-primary-custom" id="btnSubmitCourse">
              <i class="fa-solid fa-cloud-arrow-up me-1"></i> নতুন কোর্স পাবলিশ করুন
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Responsive Live Preview Sticky Column -->
    <div class="col-lg-4">
      <div class="sticky-top" style="top: 85px; z-index: 10;">
        <div class="live-preview-box shadow-sm mb-3">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-primary px-2.5 py-1 rounded-pill small">
              <i class="fa-solid fa-eye me-1"></i> রিয়েল-টাইম লাইভ প্রিভিউ
            </span>
            <small class="text-muted fw-semibold">কোর্স কার্ড প্রিভিউ</small>
          </div>

          <!-- Live Preview Card -->
          <div class="course-card bg-white mt-2">
            <div class="course-thumbnail-wrapper position-relative">
              <img
                id="previewCardImg"
                src="/images/CONTENT.png"
                alt="Course Preview"
                onerror="this.src='/images/CONTENT.png'"
              />
              <span id="previewCardBadge" class="course-badge-pill badge-new">
                New
              </span>
            </div>
            <div class="p-3 d-flex flex-column">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span id="previewCardCategory" class="badge bg-primary bg-opacity-10 text-primary small rounded-pill">
                  Web Development
                </span>
                <span id="previewCardLevel" class="small text-muted">Beginner to Advanced</span>
              </div>
              <h6 class="fw-bold text-dark mb-1 text-truncate" id="previewCardTitle">
                Course Title
              </h6>
              <p class="text-muted small mb-2 text-truncate" id="previewCardSubtitle">
                Course subtitle overview...
              </p>
              <div class="d-flex align-items-center gap-1 small text-muted mb-2">
                <span class="text-warning"><i class="fa-solid fa-star"></i> 5.0</span>
                <span>(New)</span>
                <span class="ms-auto" id="previewCardDuration"><i class="fa-regular fa-clock me-1"></i>12 Weeks</span>
              </div>
              <div class="d-flex align-items-baseline justify-content-between pt-2 border-top">
                <div>
                  <span class="fs-4 fw-bold text-success" id="previewCardPrice">৳4,500</span>
                  <span class="original-price-tag small" id="previewCardOriginalPrice">৳8,500</span>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success small py-1 px-2" id="previewSavingsTag">
                  47% OFF
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Helpful Bangladesh Commerce Tips -->
        <div class="p-3 bg-white rounded-3 border shadow-sm small text-secondary">
          <h6 class="fw-bold text-dark small mb-2"><i class="fa-solid fa-shield-halved text-success me-1"></i> লোকাল পেমেন্ট সাপোর্ট</h6>
          <p class="mb-0">
            শিক্ষার্থীরা কোর্সটিতে <strong>বিকাশ (bKash)</strong>, <strong>নগদ (Nagad)</strong>, <strong>রকেট (Rocket)</strong> এবং লোকাল ব্যাংক কার্ড দিয়ে সরাসরি রেজিস্ট্রেশন সম্পন্ন করতে পারবে।
          </p>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  function formatBDT(num) {
    if (!num || isNaN(num)) return '0';
    return Number(num).toLocaleString('en-IN');
  }

  function recalculatePricing() {
    const priceInput = document.getElementById('price');
    const originalPriceInput = document.getElementById('originalPrice');
    const discountBadge = document.getElementById('reactiveDiscountBadge');
    const discountText = document.getElementById('discountValueText');
    const savingsNotice = document.getElementById('savingsNotice');
    const savingsAmountText = document.getElementById('savingsAmountText');
    const savingsPercentText = document.getElementById('savingsPercentText');
    const pricingWarning = document.getElementById('pricingWarning');

    const price = parseFloat(priceInput.value) || 0;
    const originalPrice = parseFloat(originalPriceInput.value) || 0;

    if (originalPrice > price && price > 0) {
      const savings = originalPrice - price;
      const percent = Math.round((savings / originalPrice) * 100);

      discountBadge.classList.remove('d-none');
      discountText.textContent = `${percent}% ছাড় (${formatBDT(savings)} ৳ সাশ্রয়)`;

      savingsNotice.classList.remove('d-none');
      savingsAmountText.textContent = `৳${formatBDT(savings)} BDT`;
      savingsPercentText.textContent = `${percent}%`;

      pricingWarning.classList.add('d-none');
    } else if (originalPrice > 0 && price > originalPrice) {
      discountBadge.classList.add('d-none');
      savingsNotice.classList.add('d-none');
      pricingWarning.classList.remove('d-none');
    } else {
      discountBadge.classList.add('d-none');
      savingsNotice.classList.add('d-none');
      pricingWarning.classList.add('d-none');
    }
  }

  function updateLivePreview() {
    const title = document.getElementById('title').value || 'Course Title';
    const subtitle = document.getElementById('subtitle').value || 'Course subtitle overview...';
    const category = document.getElementById('category').value;
    const level = document.getElementById('level').value;
    const badge = document.getElementById('badge').value;
    const price = parseFloat(document.getElementById('price').value) || 0;
    const originalPrice = parseFloat(document.getElementById('originalPrice').value) || 0;
    const duration = document.getElementById('duration').value || '12 Weeks';

    document.getElementById('previewCardTitle').textContent = title;
    document.getElementById('previewCardSubtitle').textContent = subtitle;
    document.getElementById('previewCardCategory').textContent = category;
    document.getElementById('previewCardLevel').textContent = level;
    document.getElementById('previewCardDuration').innerHTML = `<i class="fa-regular fa-clock me-1"></i>${duration}`;
    document.getElementById('previewCardPrice').textContent = `৳${formatBDT(price)}`;

    const origElem = document.getElementById('previewCardOriginalPrice');
    const savingsTag = document.getElementById('previewSavingsTag');
    if (originalPrice > price) {
      origElem.textContent = `৳${formatBDT(originalPrice)}`;
      const pct = Math.round(((originalPrice - price) / originalPrice) * 100);
      savingsTag.textContent = `${pct}% OFF`;
      savingsTag.classList.remove('d-none');
    } else {
      origElem.textContent = '';
      savingsTag.textContent = 'Active';
    }

    const badgeElem = document.getElementById('previewCardBadge');
    if (badge) {
      badgeElem.className = 'course-badge-pill badge-' + badge.toLowerCase().replace(/[^a-z0-9]/g, '');
      badgeElem.textContent = badge;
      badgeElem.classList.remove('d-none');
    } else {
      badgeElem.classList.add('d-none');
    }
  }

  function previewCourseThumbnail(input) {
    const container = document.getElementById('courseThumbnailPreviewContainer');
    const preview = document.getElementById('courseThumbnailPreview');
    const cardImg = document.getElementById('previewCardImg');
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        preview.src = e.target.result;
        cardImg.src = e.target.result;
        container.classList.remove('d-none');
      }
      reader.readAsDataURL(input.files[0]);
    } else {
      container.classList.add('d-none');
    }
  }

  function handleFormSubmit(e) {
    const btn = document.getElementById('btnSubmitCourse');
    btn.disabled = true;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>পাবলিশ হচ্ছে...`;
    return true;
  }

  document.addEventListener('DOMContentLoaded', function() {
    recalculatePricing();
    updateLivePreview();
  });
</script>

<%- include('partials/footer') %>
