<%- include('partials/header', { title: 'Add New Course' }) %>
<%- include('partials/navbar', { page: 'courses' }) %>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-9">
      <div class="form-card">
        <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
          <div>
            <h2 class="h3 fw-bold mb-1">
              <i class="fa-solid fa-graduation-cap text-primary me-2"></i> Publish a New Course
            </h2>
            <p class="text-muted small mb-0">Create and list a new course on your education platform.</p>
          </div>
          <a href="/courses" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-xmark me-1"></i> Cancel
          </a>
        </div>

        <form action="/courses/add" method="POST" enctype="multipart/form-data">
          <!-- Course Title -->
          <div class="mb-3">
            <label for="title" class="form-label fw-bold">Course Title <span class="text-danger">*</span></label>
            <input
              type="text"
              class="form-control"
              id="title"
              name="title"
              placeholder="e.g. Modern Full-Stack Web Development Bootcamp"
              required
            />
          </div>

          <!-- Subtitle -->
          <div class="mb-3">
            <label for="subtitle" class="form-label fw-bold">Short Subtitle / Description <span class="text-danger">*</span></label>
            <textarea
              class="form-control"
              id="subtitle"
              name="subtitle"
              rows="2"
              placeholder="Brief summary of what this course delivers..."
              required
            ></textarea>
          </div>

          <!-- Category, Level, Badge Row -->
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label for="category" class="form-label fw-bold">Category <span class="text-danger">*</span></label>
              <select class="form-select" id="category" name="category" required>
                <option value="Web Development">Web Development</option>
                <option value="AI & Machine Learning">AI & Machine Learning</option>
                <option value="Database & SQL">Database & SQL</option>
                <option value="Cloud & DevOps">Cloud & DevOps</option>
                <option value="Mobile Development">Mobile Development</option>
                <option value="Cybersecurity">Cybersecurity</option>
              </select>
            </div>
            <div class="col-md-4">
              <label for="level" class="form-label fw-bold">Difficulty Level</label>
              <select class="form-select" id="level" name="level">
                <option value="All Levels">All Levels</option>
                <option value="Beginner to Advanced">Beginner to Advanced</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
              </select>
            </div>
            <div class="col-md-4">
              <label for="badge" class="form-label fw-bold">Promotional Badge</label>
              <select class="form-select" id="badge" name="badge">
                <option value="New">New</option>
                <option value="Bestseller">Bestseller</option>
                <option value="Hot">Hot & Trending</option>
                <option value="Popular">Popular</option>
                <option value="">None</option>
              </select>
            </div>
          </div>

          <!-- Pricing & Duration Row -->
          <div class="row g-3 mb-3">
            <div class="col-md-3">
              <label for="price" class="form-label fw-bold">Price (৳ BDT) <span class="text-danger">*</span></label>
              <input type="number" step="50" class="form-control" id="price" name="price" placeholder="4500" required />
            </div>
            <div class="col-md-3">
              <label for="originalPrice" class="form-label fw-bold">Original Price (৳ BDT)</label>
              <input type="number" step="50" class="form-control" id="originalPrice" name="originalPrice" placeholder="8500" />
            </div>
            <div class="col-md-3">
              <label for="duration" class="form-label fw-bold">Duration</label>
              <input type="text" class="form-control" id="duration" name="duration" placeholder="e.g. 12 Weeks (50h)" />
            </div>
            <div class="col-md-3">
              <label for="lessonsCount" class="form-label fw-bold">Lessons Count</label>
              <input type="number" class="form-control" id="lessonsCount" name="lessonsCount" placeholder="e.g. 64" />
            </div>
          </div>

          <!-- Thumbnail Upload -->
          <div class="mb-3">
            <label for="featureImage" class="form-label fw-bold">Course Thumbnail</label>
            <input
              type="file"
              class="form-control"
              id="featureImage"
              name="featureImage"
              accept="image/*"
              onchange="previewCourseThumbnail(this)"
            />
            <div id="courseThumbnailPreviewContainer" class="mt-2 d-none text-center p-2 bg-light rounded-3 border">
              <img id="courseThumbnailPreview" src="#" alt="Preview" class="img-fluid rounded" style="max-height: 200px;" />
            </div>
          </div>

          <!-- Highlights -->
          <div class="mb-3">
            <label for="highlights" class="form-label fw-bold">Key Course Highlights (one per line)</label>
            <textarea
              class="form-control"
              id="highlights"
              name="highlights"
              rows="4"
              placeholder="Build 5 production-ready projects&#10;Master RESTful API design&#10;Career support and code reviews"
            ></textarea>
          </div>

          <!-- Syllabus / Curriculum -->
          <div class="mb-4">
            <label for="syllabus" class="form-label fw-bold">Curriculum Lessons (one lesson per line)</label>
            <textarea
              class="form-control"
              id="syllabus"
              name="syllabus"
              rows="6"
              placeholder="Lesson 1: Introduction and Environment Setup&#10;Lesson 2: Core Fundamentals & Theory&#10;Lesson 3: Practical Hands-On Workshop&#10;Lesson 4: Deploying to Production"
            ></textarea>
          </div>

          <!-- Published Switch -->
          <div class="mb-4 p-3 bg-light rounded-3 border">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="published" name="published" checked />
              <label class="form-check-label fw-semibold" for="published">
                Publish course immediately on the catalog
              </label>
            </div>
          </div>

          <!-- Submit Buttons -->
          <div class="d-flex justify-content-end gap-2">
            <a href="/courses" class="btn btn-secondary-custom">Cancel</a>
            <button type="submit" class="btn btn-primary-custom">
              <i class="fa-solid fa-cloud-arrow-up me-1"></i> Publish Course
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<script>
  function previewCourseThumbnail(input) {
    const container = document.getElementById('courseThumbnailPreviewContainer');
    const preview = document.getElementById('courseThumbnailPreview');
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        preview.src = e.target.result;
        container.classList.remove('d-none');
      }
      reader.readAsDataURL(input.files[0]);
    } else {
      container.classList.add('d-none');
    }
  }
</script>

<%- include('partials/footer') %>

