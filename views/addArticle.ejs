<%- include('partials/header', { title: 'Add Article' }) %>
<%- include('partials/navbar', { page: 'addArticle' }) %>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="form-card">
        <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
          <div>
            <h2 class="h3 fw-bold mb-1">
              <i class="fa-solid fa-pen-nib text-primary me-2"></i> Add New Article
            </h2>
            <p class="text-muted small mb-0">Fill out the fields below to create and publish a new post.</p>
          </div>
          <a href="/articles" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-xmark me-1"></i> Cancel
          </a>
        </div>

        <form action="/articles/add" method="POST" enctype="multipart/form-data">
          <!-- Title -->
          <div class="mb-3">
            <label for="title" class="form-label fw-bold">Article Title <span class="text-danger">*</span></label>
            <input
              type="text"
              class="form-control"
              id="title"
              name="title"
              placeholder="e.g. Getting Started with Modern Node.js"
              required
            />
          </div>

          <!-- Category & Author Row -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="category" class="form-label fw-bold">Category <span class="text-danger">*</span></label>
              <select class="form-select" id="category" name="category" required>
                <option value="" disabled selected>-- Select a Category --</option>
                <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.name %>"><%= cat.name %></option>
                  <% }); %>
                <% } else { %>
                  <option value="Programming">Programming</option>
                  <option value="AI">AI</option>
                  <option value="Data">Data</option>
                  <option value="Technology">Technology</option>
                <% } %>
              </select>
            </div>
            <div class="col-md-6">
              <label for="author" class="form-label fw-bold">Author Name</label>
              <input
                type="text"
                class="form-control"
                id="author"
                name="author"
                value="MD ARAFAT KOYES"
                placeholder="Author name"
              />
            </div>
          </div>

          <!-- Feature Image Upload -->
          <div class="mb-3">
            <label for="featureImage" class="form-label fw-bold">Feature Image</label>
            <input
              type="file"
              class="form-control"
              id="featureImage"
              name="featureImage"
              accept="image/*"
              onchange="previewUploadedImage(this)"
            />
            <div class="form-text">Supported formats: JPG, PNG, WEBP, GIF. Uploaded to Cloudinary CDN.</div>
            
            <!-- Image Preview Box -->
            <div id="imagePreviewContainer" class="mt-3 d-none text-center p-2 bg-light rounded-3 border">
              <img id="imagePreview" src="#" alt="Preview" class="img-fluid rounded-2" style="max-height: 220px;" />
            </div>
          </div>

          <!-- Content -->
          <div class="mb-4">
            <label for="content" class="form-label fw-bold">Article Content <span class="text-danger">*</span></label>
            <textarea
              class="form-control"
              id="content"
              name="content"
              rows="8"
              placeholder="Write your article content here..."
              required
            ></textarea>
          </div>

          <!-- Published Switch -->
          <div class="mb-4 p-3 bg-light rounded-3 border">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="published" name="published" checked />
              <label class="form-check-label fw-semibold" for="published">
                Publish immediately
              </label>
            </div>
            <small class="text-muted d-block mt-1">If unchecked, this article will be saved as an unpublished draft.</small>
          </div>

          <!-- Form Buttons -->
          <div class="d-flex justify-content-end gap-2">
            <a href="/articles" class="btn btn-secondary-custom">Cancel</a>
            <button type="submit" class="btn btn-primary-custom">
              <i class="fa-solid fa-cloud-arrow-up me-1"></i> Publish Article
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<script>
  function previewUploadedImage(input) {
    const previewContainer = document.getElementById('imagePreviewContainer');
    const previewImage = document.getElementById('imagePreview');
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        previewImage.src = e.target.result;
        previewContainer.classList.remove('d-none');
      }
      reader.readAsDataURL(input.files[0]);
    } else {
      previewContainer.classList.add('d-none');
    }
  }
</script>

<%- include('partials/footer') %>

