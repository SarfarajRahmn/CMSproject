<%- include('partials/header', { title: 'Courses - Master Tech Skills' }) %>
<%- include('partials/navbar', { page: 'courses' }) %>

<main class="container my-5">
  <!-- Hero / Header -->
  <div class="row align-items-center mb-5">
    <div class="col-lg-8">
      <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">
        <i class="fa-solid fa-graduation-cap me-1"></i> Career-Ready Tech Education
      </span>
      <h1 class="display-5 fw-bold mb-2">Explore Industry-Standard Courses</h1>
      <p class="lead text-muted mb-0">
        Accelerate your career with project-based, in-depth courses in full-stack development, generative AI, cloud infrastructure, and modern databases.
      </p>
    </div>
    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
      <a href="/courses/add" class="btn btn-primary-custom">
        <i class="fa-solid fa-plus me-1"></i> Publish New Course
      </a>
    </div>
  </div>

  <!-- Search & Category Filters -->
  <div class="card p-3 border-0 shadow-sm rounded-4 mb-4">
    <div class="row g-3 align-items-center">
      <div class="col-md-6">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <input
            type="text"
            id="courseSearchInput"
            class="form-control border-start-0 ps-0"
            placeholder="Search by course title, skill, or keyword..."
            onkeyup="filterCoursesList()"
          />
        </div>
      </div>
      <div class="col-md-6">
        <div class="d-flex flex-wrap gap-2 justify-content-md-end">
          <a href="/courses" class="btn btn-sm <%= !selectedCategory ? 'btn-primary-custom' : 'btn-outline-secondary' %>">
            All Courses
          </a>
          <a href="/courses?category=Web" class="btn btn-sm <%= selectedCategory === 'Web' ? 'btn-primary-custom' : 'btn-outline-secondary' %>">
            Web Dev
          </a>
          <a href="/courses?category=AI" class="btn btn-sm <%= selectedCategory === 'AI' ? 'btn-primary-custom' : 'btn-outline-secondary' %>">
            AI & ML
          </a>
          <a href="/courses?category=Database" class="btn btn-sm <%= selectedCategory === 'Database' ? 'btn-primary-custom' : 'btn-outline-secondary' %>">
            Databases
          </a>
          <a href="/courses?category=Cloud" class="btn btn-sm <%= selectedCategory === 'Cloud' ? 'btn-primary-custom' : 'btn-outline-secondary' %>">
            DevOps & Cloud
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Courses Grid -->
  <div class="row g-4 mb-5" id="coursesGrid">
    <% if (courses && courses.length > 0) { %>
      <% courses.forEach(course => { %>
        <div class="col-md-6 col-lg-4 course-card-wrapper" data-title="<%= (course.title || '').toLowerCase() %>" data-subtitle="<%= (course.subtitle || '').toLowerCase() %>" data-category="<%= (course.category || '').toLowerCase() %>">
          <div class="course-card">
            <!-- Thumbnail & Badge -->
            <div class="course-thumbnail-wrapper">
              <img
                src="<%= course.thumbnail || '/images/CONTENT.png' %>"
                alt="<%= course.title %>"
                onerror="this.src='/images/CONTENT.png'"
              />
              <% if (course.badge) { %>
                <span class="course-badge-pill badge-<%= course.badge.toLowerCase().replace(/[^a-z0-9]/g, '') %>">
                  <i class="fa-solid fa-bolt me-1"></i><%= course.badge %>
                </span>
              <% } %>
            </div>

            <!-- Card Body -->
            <div class="p-4 d-flex flex-column flex-grow-1">
              <!-- Meta header -->
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-primary bg-opacity-10 text-primary px-2.5 py-1 rounded-pill small fw-semibold">
                  <%= course.category %>
                </span>
                <span class="small text-muted fw-semibold">
                  <i class="fa-solid fa-signal me-1"></i><%= course.level %>
                </span>
              </div>

              <!-- Title -->
              <h5 class="fw-bold mb-2">
                <a href="/courses/<%= course.id %>" class="text-dark text-decoration-none">
                  <%= course.title %>
                </a>
              </h5>

              <!-- Subtitle excerpt -->
              <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= course.subtitle %>
              </p>

              <!-- Ratings & Enrolled -->
              <div class="d-flex align-items-center gap-2 mb-3 small">
                <span class="rating-stars">
                  <i class="fa-solid fa-star"></i>
                  <strong class="text-dark ms-1"><%= course.rating || 4.9 %></strong>
                </span>
                <span class="text-muted">(<%= course.reviewsCount || 120 %> reviews)</span>
                <span class="ms-auto text-secondary fw-semibold">
                  <i class="fa-solid fa-users me-1"></i><%= (course.enrolledCount || 0).toLocaleString() %>
                </span>
              </div>

              <!-- Course Specs -->
              <div class="d-flex gap-3 text-muted small mb-3 pb-3 border-bottom">
                <span><i class="fa-regular fa-clock me-1"></i><%= course.duration %></span>
                <span><i class="fa-solid fa-play-circle me-1"></i><%= course.lessonsCount %> Lessons</span>
              </div>

              <!-- Pricing & CTA -->
              <div class="mt-auto d-flex align-items-center justify-content-between pt-2">
                <div>
                  <span class="price-tag">$<%= course.price %></span>
                  <% if (course.originalPrice && course.originalPrice > course.price) { %>
                    <span class="original-price-tag">$<%= course.originalPrice %></span>
                  <% } %>
                </div>
                <div class="d-flex gap-2">
                  <a href="/courses/<%= course.id %>" class="btn btn-outline-primary btn-sm">
                    View Course
                  </a>
                  <button type="button" class="btn btn-primary-custom btn-sm" onclick="openEnrollModal(<%= course.id %>, '<%= course.title.replace(/'/g, "\\'") %>', <%= course.price %>)">
                    Enroll Now
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-12 text-center py-5">
        <div class="p-5 bg-white rounded-4 shadow-sm border">
          <i class="fa-solid fa-graduation-cap fa-3x text-muted mb-3"></i>
          <h4>No Courses Available</h4>
          <p class="text-muted">There are no courses matching your filter criteria.</p>
          <a href="/courses/add" class="btn btn-primary-custom mt-2">
            <i class="fa-solid fa-plus me-1"></i> Add Your First Course
          </a>
        </div>
      </div>
    <% } %>
  </div>
</main>

<!-- Quick Enroll Modal -->
<div class="modal fade" id="enrollModal" tabindex="-1" aria-labelledby="enrollModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="modal-header bg-dark-navy text-white border-0 py-3">
        <h5 class="modal-title fw-bold" id="enrollModalLabel">
          <i class="fa-solid fa-cart-shopping me-2 text-warning"></i> Complete Your Enrollment
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/courses/enroll" method="POST">
        <input type="hidden" id="modalCourseId" name="courseId" value="" />
        <div class="modal-body p-4">
          <div class="p-3 bg-light rounded-3 mb-3 border">
            <div class="small text-muted">Selected Course:</div>
            <h6 class="fw-bold mb-1 text-primary" id="modalCourseTitle">Course Title</h6>
            <div class="d-flex justify-content-between align-items-center mt-2">
              <span class="text-muted small">Total Investment:</span>
              <span class="fw-bold fs-5 text-success" id="modalCoursePrice">$0</span>
            </div>
          </div>

          <div class="mb-3">
            <label for="studentName" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="studentName" name="studentName" placeholder="Enter your full name" required />
          </div>

          <div class="mb-3">
            <label for="studentEmail" class="form-label fw-bold">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control" id="studentEmail" name="studentEmail" placeholder="you@example.com" required />
            <small class="text-muted">Your course access link and receipts are sent here.</small>
          </div>

          <div class="mb-3">
            <label for="paymentMethod" class="form-label fw-bold">Payment Method</label>
            <select class="form-select" id="paymentMethod" name="paymentMethod">
              <option value="Credit / Debit Card">Credit / Debit Card (Stripe)</option>
              <option value="PayPal">PayPal</option>
              <option value="Mobile Banking">Mobile Banking (bKash / Nagad / Rocket)</option>
            </select>
          </div>

          <div class="p-2 bg-success bg-opacity-10 rounded-2 text-success small">
            <i class="fa-solid fa-shield-check me-1"></i> 30-Day 100% Money-Back Satisfaction Guarantee.
          </div>
        </div>
        <div class="modal-footer border-0 pt-0 pb-4 px-4">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-custom btn-lg w-100 mt-2">
            <i class="fa-solid fa-lock me-2"></i> Confirm Enrollment & Pay
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function filterCoursesList() {
    const query = document.getElementById('courseSearchInput').value.toLowerCase();
    const items = document.querySelectorAll('.course-card-wrapper');
    items.forEach(item => {
      const title = item.getAttribute('data-title') || '';
      const subtitle = item.getAttribute('data-subtitle') || '';
      const cat = item.getAttribute('data-category') || '';
      if (title.includes(query) || subtitle.includes(query) || cat.includes(query)) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }

  function openEnrollModal(courseId, title, price) {
    document.getElementById('modalCourseId').value = courseId;
    document.getElementById('modalCourseTitle').textContent = title;
    document.getElementById('modalCoursePrice').textContent = '$' + price;
    const modal = new bootstrap.Modal(document.getElementById('enrollModal'));
    modal.show();
  }
</script>

<%- include('partials/footer') %>
