<%- include('partials/header', { title: 'Courses - Master Tech Skills' }) %>
<%- include('partials/navbar', { page: 'courses' }) %>

<main class="container my-4 my-md-5">
  <!-- Hero / Header -->
  <div class="row align-items-center mb-4 mb-md-5 g-3">
    <div class="col-lg-8">
      <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">
        <i class="fa-solid fa-graduation-cap me-1"></i> ক্যারিয়ার-ফোকাসড প্রফেশনাল টেক কোর্স
      </span>
      <h1 class="display-5 fw-bold mb-2">প্রজেক্ট-ভিত্তিক টেক কোর্সসমূহ</h1>
      <p class="lead text-muted mb-0">
        আন্তর্জাতিক মানের কারিকুলাম ও বাস্তব প্রজেক্টের মাধ্যমে শিখুন ফুল-স্ট্যাক ওয়েব ডেভেলপমেন্ট, জেনারেটিভ এআই, ডকার/ডেভঅপ্স এবং ডাটাবেস আর্কিটেকচার।
      </p>
    </div>
    <div class="col-lg-4 text-lg-end">
      <a href="/courses/add" class="btn btn-primary-custom">
        <i class="fa-solid fa-plus me-1"></i> নতুন কোর্স যোগ করুন
      </a>
    </div>
  </div>

  <!-- Search & Category Filters (Reactive Toolbar) -->
  <div class="card p-3 border-0 shadow-sm rounded-4 mb-4">
    <div class="row g-3 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <input
            type="text"
            id="courseSearchInput"
            class="form-control border-start-0 ps-0"
            placeholder="কোর্স বা স্কিল খুঁজুন (e.g. React, Python, Docker)..."
            oninput="applyReactiveFilters()"
          />
        </div>
      </div>
      <div class="col-md-7">
        <div class="d-flex flex-wrap gap-2 justify-content-md-end" id="categoryFilterPills">
          <button type="button" class="btn btn-sm btn-primary-custom cat-filter-btn active" data-cat="all" onclick="selectCategoryFilter('all', this)">
            সকল কোর্স
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary cat-filter-btn" data-cat="web" onclick="selectCategoryFilter('web', this)">
            Web Dev
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary cat-filter-btn" data-cat="ai" onclick="selectCategoryFilter('ai', this)">
            AI & ML
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary cat-filter-btn" data-cat="database" onclick="selectCategoryFilter('database', this)">
            Databases
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary cat-filter-btn" data-cat="cloud" onclick="selectCategoryFilter('cloud', this)">
            DevOps & Cloud
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Results Count Indicator -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="small text-muted fw-semibold">
      মোট কোর্স প্রদর্শিত হচ্ছে: <span id="visibleCoursesCount" class="text-primary fw-bold"><%= courses ? courses.length : 0 %></span> টি
    </div>
  </div>

  <!-- Courses Grid -->
  <div class="row g-4 mb-5" id="coursesGrid">
    <% if (courses && courses.length > 0) { %>
      <% courses.forEach(course => { %>
        <div
          class="col-12 col-md-6 col-lg-4 course-card-wrapper"
          data-title="<%= (course.title || '').toLowerCase() %>"
          data-subtitle="<%= (course.subtitle || '').toLowerCase() %>"
          data-category="<%= (course.category || '').toLowerCase() %>"
        >
          <div class="course-card h-100 d-flex flex-column">
            <!-- Thumbnail & Badge -->
            <div class="course-thumbnail-wrapper position-relative">
              <img
                src="<%= course.thumbnail || '/images/CONTENT.png' %>"
                alt="<%= course.title %>"
                class="img-fluid w-100"
                style="height: 190px; object-fit: cover;"
                onerror="this.src='/images/CONTENT.png'"
              />
              <% if (course.badge) { %>
                <span class="course-badge-pill badge-<%= course.badge.toLowerCase().replace(/[^a-z0-9]/g, '') %>">
                  <i class="fa-solid fa-bolt me-1"></i><%= course.badge %>
                </span>
              <% } %>
            </div>

            <!-- Card Body -->
            <div class="p-3 p-md-4 d-flex flex-column flex-grow-1">
              <!-- Meta header -->
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-primary bg-opacity-10 text-primary px-2.5 py-1 rounded-pill small fw-semibold">
                  <%= course.category %>
                </span>
                <span class="small text-muted fw-semibold">
                  <i class="fa-solid fa-signal me-1"></i><%= course.level %>
                </span>
              </div>

              <!-- Title -->
              <h5 class="fw-bold mb-2">
                <a href="/courses/<%= course.id %>" class="text-dark text-decoration-none">
                  <%= course.title %>
                </a>
              </h5>

              <!-- Subtitle excerpt -->
              <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= course.subtitle %>
              </p>

              <!-- Ratings & Enrolled -->
              <div class="d-flex align-items-center gap-2 mb-3 small">
                <span class="rating-stars">
                  <i class="fa-solid fa-star"></i>
                  <strong class="text-dark ms-1"><%= course.rating || 4.9 %></strong>
                </span>
                <span class="text-muted">(<%= course.reviewsCount || 120 %>)</span>
                <span class="ms-auto text-secondary fw-semibold">
                  <i class="fa-solid fa-users me-1 text-primary"></i><%= (course.enrolledCount || 0).toLocaleString('en-IN') %>+
                </span>
              </div>

              <!-- Course Specs -->
              <div class="d-flex gap-3 text-muted small mb-3 pb-3 border-bottom flex-wrap">
                <span><i class="fa-regular fa-clock me-1"></i><%= course.duration %></span>
                <span><i class="fa-solid fa-play-circle me-1"></i><%= course.lessonsCount %> Lectures</span>
              </div>

              <!-- Bangladesh Pricing & Reactive CTA -->
              <div class="mt-auto d-flex align-items-center justify-content-between pt-2 gap-2 flex-wrap">
                <div>
                  <span class="price-tag fs-4 fw-bold text-success">৳<%= Number(course.price).toLocaleString('en-IN') %></span>
                  <% if (course.originalPrice && course.originalPrice > course.price) { %>
                    <span class="original-price-tag small text-muted text-decoration-line-through">৳<%= Number(course.originalPrice).toLocaleString('en-IN') %></span>
                  <% } %>
                </div>
                <div class="d-flex gap-2">
                  <a href="/courses/<%= course.id %>" class="btn btn-outline-primary btn-sm">
                    ডিটেইলস
                  </a>
                  <button
                    type="button"
                    class="btn btn-primary-custom btn-sm px-3"
                    onclick="openEnrollModal(<%= course.id %>, '<%= course.title.replace(/'/g, "\\'") %>', <%= course.price %>)"
                  >
                    এনরোল করুন
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>

    <!-- Empty State -->
    <div class="col-12 text-center py-5 d-none" id="noCoursesFoundMessage">
      <div class="p-5 bg-white rounded-4 shadow-sm border">
        <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>
        <h4>কোন কোর্স খুঁজে পাওয়া যায়নি</h4>
        <p class="text-muted">আপনার খোঁজার সাথে মিল রেখে কোনো কোর্স নেই। দয়া করে অন্য কোনো কীওয়ার্ড ব্যবহার করুন।</p>
        <button type="button" class="btn btn-outline-primary mt-2" onclick="resetFilters()">
          ফিল্টার রিসেট করুন
        </button>
      </div>
    </div>
  </div>
</main>

<!-- Reactive Bangladesh Checkout & Enrollment Modal -->
<div class="modal fade" id="enrollModal" tabindex="-1" aria-labelledby="enrollModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <!-- Modal Header -->
      <div class="modal-header bg-dark-navy text-white border-0 py-3 px-4">
        <div class="d-flex align-items-center gap-2">
          <i class="fa-solid fa-shield-halved text-warning fs-5"></i>
          <div>
            <h5 class="modal-title fw-bold mb-0" id="enrollModalLabel">কোর্স এনরোলমেন্ট ও পেমেন্ট</h5>
            <small class="text-white-50">ইনস্ট্যান্ট অ্যাক্সেস ও নিশ্চিত ভেরিফিকেশন</small>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/courses/enroll" method="POST" id="reactiveEnrollForm" onsubmit="return handleEnrollSubmit(event)">
        <input type="hidden" id="modalCourseId" name="courseId" value="" />
        <input type="hidden" id="modalCoursePriceInput" name="coursePrice" value="" />

        <div class="modal-body p-4">
          <div class="row g-4">
            <!-- Left Column: Student Details -->
            <div class="col-md-6 border-end-md">
              <h6 class="fw-bold text-dark mb-3">
                <i class="fa-solid fa-user-graduate text-primary me-2"></i>১. শিক্ষার্থীর তথ্য
              </h6>

              <div class="mb-3">
                <label for="studentName" class="form-label small fw-bold">আপনার পূর্ণ নাম <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="studentName" name="studentName" placeholder="e.g. তানভীর আহমেদ" required />
              </div>

              <div class="mb-3">
                <label for="studentEmail" class="form-label small fw-bold">ইমেইল অ্যাড্রেস <span class="text-danger">*</span></label>
                <input type="email" class="form-control" id="studentEmail" name="studentEmail" placeholder="you@example.com" required />
                <div class="form-text small">কোর্সের লগইন ও ক্লাসরুম লিঙ্ক এই ইমেইলে যাবে।</div>
              </div>

              <div class="mb-3">
                <label for="studentPhone" class="form-label small fw-bold">মোবাইল নম্বর <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light text-muted small">+88</span>
                  <input
                    type="tel"
                    class="form-control"
                    id="studentPhone"
                    name="studentPhone"
                    placeholder="017XXXXXXXX"
                    pattern="[0-9]{11}"
                    title="১১ ডিজিটের সঠিক মোবাইল নম্বর দিন"
                    required
                  />
                </div>
              </div>
            </div>

            <!-- Right Column: Course Summary & Payment Method -->
            <div class="col-md-6">
              <h6 class="fw-bold text-dark mb-3">
                <i class="fa-solid fa-credit-card text-success me-2"></i>২. পেমেন্ট ও সামারি
              </h6>

              <!-- Selected Course Card -->
              <div class="p-3 bg-light rounded-3 mb-3 border">
                <div class="small text-muted">নির্বাচিত কোর্স:</div>
                <h6 class="fw-bold mb-1 text-primary text-truncate" id="modalCourseTitle">Course Title</h6>
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                  <span class="text-muted small">মোট প্রদেয় ফি:</span>
                  <span class="fw-bold fs-4 text-success" id="modalCoursePrice">৳০</span>
                </div>
              </div>

              <!-- Payment Method Selection -->
              <div class="mb-3">
                <label class="form-label small fw-bold">পেমেন্ট মেথড নির্বাচন করুন</label>
                <div class="d-flex flex-wrap gap-2 mb-2" id="paymentMethodSelector">
                  <button type="button" class="btn btn-sm btn-outline-primary active flex-fill py-2 pay-opt-btn" onclick="selectPaymentMethod('bKash', this)">
                    <i class="fa-solid fa-mobile-screen me-1 text-danger"></i> বিকাশ (bKash)
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-primary flex-fill py-2 pay-opt-btn" onclick="selectPaymentMethod('Nagad', this)">
                    <i class="fa-solid fa-wallet me-1 text-warning"></i> নগদ (Nagad)
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-primary flex-fill py-2 pay-opt-btn" onclick="selectPaymentMethod('Card', this)">
                    <i class="fa-solid fa-credit-card me-1 text-info"></i> কার্ড / অন্যান্য
                  </button>
                </div>
                <input type="hidden" id="selectedPaymentMethod" name="paymentMethod" value="bKash" />
              </div>

              <!-- Reactive Payment Instructions Box -->
              <div id="paymentInstructionsBox" class="p-3 rounded-3 border bg-light mb-3">
                <!-- bKash instructions -->
                <div id="instrBkash">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge bg-danger">bKash Personal / Send Money</span>
                    <strong class="text-dark font-monospace user-select-all" id="bkashNumber">01712-345678</strong>
                  </div>
                  <ol class="small text-secondary ps-3 mb-2">
                    <li>বিকাশ অ্যাপ ওপেন করে <strong>Send Money</strong> সিলেক্ট করুন।</li>
                    <li>নম্বর দিন: <strong>01712-345678</strong> এবং কোর্স ফি সেন্ড করুন।</li>
                    <li>পেমেন্ট সফল হলে প্রাপ্ত <strong>Transaction ID (TrxID)</strong> নিচে লিখুন।</li>
                  </ol>
                </div>

                <!-- Nagad instructions -->
                <div id="instrNagad" class="d-none">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge bg-warning text-dark">Nagad Personal / Send Money</span>
                    <strong class="text-dark font-monospace user-select-all">01898-765432</strong>
                  </div>
                  <ol class="small text-secondary ps-3 mb-2">
                    <li>নগদ অ্যাপে ঢুকে <strong>Send Money</strong> অপশন বেছে নিন।</li>
                    <li>নম্বর: <strong>01898-765432</strong> এ কোর্স ফি প্রদান করুন।</li>
                    <li>এসএমএস বা রিসিট থেকে <strong>TrxID</strong> নিচে এন্টার করুন।</li>
                  </ol>
                </div>

                <!-- Card instructions -->
                <div id="instrCard" class="d-none">
                  <div class="small text-secondary mb-2">
                    <i class="fa-solid fa-shield-check text-success me-1"></i> Visa, Mastercard, DBBL Nexus ও যেকোনো ব্যাংকের কার্ড সাপোর্টেড।
                  </div>
                  <small class="text-muted">এনরোল কনফার্ম করার পর সিকিউরড পেমেন্ট গেটওয়ে পেজে রিডাইরেক্ট হবে।</small>
                </div>
              </div>

              <!-- Transaction ID Input (for bKash / Nagad) -->
              <div class="mb-3" id="trxIdContainer">
                <label for="trxId" class="form-label small fw-bold">
                  বিকাশ / নগদ ট্রানজেকশন আইডি (TrxID) <span class="text-danger">*</span>
                </label>
                <input
                  type="text"
                  class="form-control font-monospace"
                  id="trxId"
                  name="trxId"
                  placeholder="e.g. 9J7K2L8M1N"
                  required
                />
              </div>

              <!-- Guarantee Badge -->
              <div class="p-2 bg-success bg-opacity-10 rounded-2 text-success small text-center">
                <i class="fa-solid fa-badge-check me-1"></i> ১০০% মানিব্যাক গ্যারান্টি &bull; ৭ দিনের ট্রায়াল সুবিধা
              </div>
            </div>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="modal-footer border-0 pt-0 pb-4 px-4">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">বাতিল</button>
          <button type="submit" class="btn btn-primary-custom btn-lg flex-grow-1" id="btnSubmitEnroll">
            <i class="fa-solid fa-lock me-1"></i> এনরোলমেন্ট কনফার্ম করুন
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  let currentActiveCategory = 'all';

  function selectCategoryFilter(cat, btn) {
    currentActiveCategory = cat.toLowerCase();
    document.querySelectorAll('.cat-filter-btn').forEach(b => {
      b.classList.remove('btn-primary-custom', 'active');
      b.classList.add('btn-outline-secondary');
    });
    btn.classList.add('btn-primary-custom', 'active');
    btn.classList.remove('btn-outline-secondary');
    applyReactiveFilters();
  }

  function applyReactiveFilters() {
    const searchVal = (document.getElementById('courseSearchInput').value || '').toLowerCase().trim();
    const items = document.querySelectorAll('.course-card-wrapper');
    let visibleCount = 0;

    items.forEach(item => {
      const title = item.getAttribute('data-title') || '';
      const subtitle = item.getAttribute('data-subtitle') || '';
      const category = item.getAttribute('data-category') || '';

      const matchesSearch = !searchVal || title.includes(searchVal) || subtitle.includes(searchVal) || category.includes(searchVal);
      const matchesCat = currentActiveCategory === 'all' || category.includes(currentActiveCategory);

      if (matchesSearch && matchesCat) {
        item.classList.remove('d-none');
        visibleCount++;
      } else {
        item.classList.add('d-none');
      }
    });

    document.getElementById('visibleCoursesCount').textContent = visibleCount;
    const noMsg = document.getElementById('noCoursesFoundMessage');
    if (visibleCount === 0) {
      noMsg.classList.remove('d-none');
    } else {
      noMsg.classList.add('d-none');
    }
  }

  function resetFilters() {
    document.getElementById('courseSearchInput').value = '';
    const allBtn = document.querySelector('.cat-filter-btn[data-cat="all"]');
    if (allBtn) selectCategoryFilter('all', allBtn);
  }

  function selectPaymentMethod(method, btn) {
    document.getElementById('selectedPaymentMethod').value = method;
    document.querySelectorAll('.pay-opt-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const instrBkash = document.getElementById('instrBkash');
    const instrNagad = document.getElementById('instrNagad');
    const instrCard = document.getElementById('instrCard');
    const trxContainer = document.getElementById('trxIdContainer');
    const trxInput = document.getElementById('trxId');

    instrBkash.classList.add('d-none');
    instrNagad.classList.add('d-none');
    instrCard.classList.add('d-none');

    if (method === 'bKash') {
      instrBkash.classList.remove('d-none');
      trxContainer.classList.remove('d-none');
      trxInput.required = true;
    } else if (method === 'Nagad') {
      instrNagad.classList.remove('d-none');
      trxContainer.classList.remove('d-none');
      trxInput.required = true;
    } else {
      instrCard.classList.remove('d-none');
      trxContainer.classList.add('d-none');
      trxInput.required = false;
    }
  }

  function openEnrollModal(courseId, title, price) {
    document.getElementById('modalCourseId').value = courseId;
    document.getElementById('modalCoursePriceInput').value = price;
    document.getElementById('modalCourseTitle').textContent = title;
    document.getElementById('modalCoursePrice').textContent = '৳' + Number(price).toLocaleString('en-IN');
    document.getElementById('btnSubmitEnroll').innerHTML = `<i class="fa-solid fa-lock me-1"></i> এনরোল কনফার্ম করুন (৳${Number(price).toLocaleString('en-IN')})`;
    const modal = new bootstrap.Modal(document.getElementById('enrollModal'));
    modal.show();
  }

  function handleEnrollSubmit(e) {
    const btn = document.getElementById('btnSubmitEnroll');
    btn.disabled = true;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>এনরোলমেন্ট প্রসেসিং হচ্ছে...`;
    return true;
  }
</script>

<%- include('partials/footer') %>
