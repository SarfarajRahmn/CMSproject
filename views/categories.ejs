<%- include('partials/header', { title: 'Categories' }) %>
<%- include('partials/navbar', { page: 'categories' }) %>

<main class="container my-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h2 fw-bold mb-1">
        <i class="fa-solid fa-folder-tree text-primary me-2"></i> Categories
      </h1>
      <p class="text-muted mb-0">Browse and manage content taxonomy and classification tags.</p>
    </div>
    <button type="button" class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
      <i class="fa-solid fa-plus me-1"></i> Add Category
    </button>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Categories Grid -->
  <div class="row g-4 mb-5">
    <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
      <% categories.forEach(category => { %>
        <div class="col-md-6 col-lg-3">
          <div class="card p-4 border-0 shadow-sm h-100 position-relative rounded-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <span class="badge-category badge-cat-<%= (category.name || 'general').toLowerCase() %>">
                <i class="fa-solid fa-tag"></i> ID #<%= category.id %>
              </span>
              <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">
                Active
              </span>
            </div>
            <h4 class="fw-bold mb-2 text-dark"><%= category.name %></h4>
            <p class="text-muted small mb-4 flex-grow-1">
              <%= category.description || 'Topic discussions, articles, and guides.' %>
            </p>
            <div class="pt-3 border-top mt-auto">
              <a href="/articles?category=<%= encodeURIComponent(category.name) %>" class="btn btn-sm btn-outline-primary w-100">
                <i class="fa-solid fa-arrow-right me-1"></i> View Articles
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-12 text-center py-5">
        <div class="p-5 bg-white rounded-4 shadow-sm">
          <i class="fa-solid fa-folder-open fa-3x text-muted mb-3"></i>
          <h4>No Categories Found</h4>
          <p class="text-muted">Create your first category to start organizing content.</p>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Detailed Table -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 border-bottom">
      <h5 class="fw-bold mb-0">All Category Details</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 80px;">ID</th>
            <th>Category Name</th>
            <th>Description</th>
            <th class="text-end" style="width: 160px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
              <tr>
                <td class="fw-bold text-muted">#<%= category.id %></td>
                <td>
                  <span class="badge-category badge-cat-<%= (category.name || 'general').toLowerCase() %>">
                    <%= category.name %>
                  </span>
                </td>
                <td class="text-secondary"><%= category.description || '—' %></td>
                <td class="text-end">
                  <a href="/articles?category=<%= encodeURIComponent(category.name) %>" class="btn btn-sm btn-outline-primary">
                    <i class="fa-solid fa-filter me-1"></i> Articles
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form action="/categories/add" method="POST">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="addCategoryModalLabel">
            <i class="fa-solid fa-folder-plus text-primary me-2"></i> Add New Category
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body py-4">
          <div class="mb-3">
            <label for="catName" class="form-label fw-bold">Category Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="catName" name="name" placeholder="e.g. DevOps, Mobile" required />
          </div>
          <div class="mb-3">
            <label for="catDescription" class="form-label fw-bold">Description</label>
            <textarea class="form-control" id="catDescription" name="description" rows="3" placeholder="Brief description of this category"></textarea>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-custom">
            <i class="fa-solid fa-plus me-1"></i> Save Category
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

