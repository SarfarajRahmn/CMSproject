<%- include('partials/header', { title: 'Home - DevAcademy & CMS' }) %>
<%- include('partials/navbar', { page: 'home' }) %>

<main class="container my-4">
  <!-- Hero Section -->
  <section class="hero-section text-center text-md-start">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <span class="hero-badge"><i class="fa-solid fa-graduation-cap me-1"></i> Learn & Build Real Software</span>
        <h1 class="display-4 fw-bold text-white mb-3">Master High-Demand Tech Skills & Build Scalable Systems</h1>
        <p class="lead text-white-50 mb-4">
          Discover hands-on courses in Full-Stack Web Development, AI Systems, Cloud DevOps, and Database Architecture. Read insightful articles, publish tutorials, and level up your software engineering career.
        </p>
        <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-md-start">
          <a href="/courses" class="btn btn-warning btn-lg fw-bold px-4 text-dark shadow-sm">
            <i class="fa-solid fa-fire me-2"></i> Explore Courses
          </a>
          <a href="/articles" class="btn btn-primary-custom btn-lg">
            <i class="fa-solid fa-book-open me-2"></i> Read Articles
          </a>
        </div>
      </div>
      <div class="col-lg-4 text-center mt-4 mt-lg-0">
        <img
          src="/images/CONTENT.png"
          alt="CMS & Learning Overview"
          class="img-fluid rounded-4 shadow-lg"
          style="max-height: 280px; object-fit: contain;"
          onerror="this.src='/images/Ai generated.png'"
        />
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="row g-3 mb-5">
    <div class="col-6 col-md-3">
      <div class="stat-box">
        <div class="stat-number"><%= typeof courses !== 'undefined' && courses ? courses.length : 4 %>+</div>
        <div class="text-muted small fw-semibold"><i class="fa-solid fa-graduation-cap me-1 text-warning"></i> Premium Courses</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-box">
        <div class="stat-number">5,100+</div>
        <div class="text-muted small fw-semibold"><i class="fa-solid fa-users me-1 text-success"></i> Active Students</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-box">
        <div class="stat-number"><%= articles ? articles.length : 0 %></div>
        <div class="text-muted small fw-semibold"><i class="fa-solid fa-newspaper me-1 text-primary"></i> Tech Articles</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-box">
        <div class="stat-number">4.9 / 5</div>
        <div class="text-muted small fw-semibold"><i class="fa-solid fa-star me-1 text-warning"></i> Average Rating</div>
      </div>
    </div>
  </section>

  <!-- FEATURED COURSES SECTION -->
  <section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-1 rounded-pill fw-bold small mb-1">
          <i class="fa-solid fa-fire text-danger me-1"></i> Best Sellers
        </span>
        <h2 class="h3 fw-bold mb-1">Featured Premium Courses</h2>
        <p class="text-muted mb-0">Project-based, mentor-led courses engineered to advance your career</p>
      </div>
      <a href="/courses" class="btn btn-outline-primary btn-sm">
        All Courses <i class="fa-solid fa-arrow-right ms-1"></i>
      </a>
    </div>

    <div class="row g-4">
      <% if (typeof courses !== 'undefined' && courses && courses.length > 0) { %>
        <% courses.slice(0, 3).forEach(course => { %>
          <div class="col-md-6 col-lg-4">
            <div class="course-card">
              <div class="course-thumbnail-wrapper">
                <img
                  src="<%= course.thumbnail || '/images/CONTENT.png' %>"
                  alt="<%= course.title %>"
                  onerror="this.src='/images/CONTENT.png'"
                />
                <% if (course.badge) { %>
                  <span class="course-badge-pill badge-<%= course.badge.toLowerCase().replace(/[^a-z0-9]/g, '') %>">
                    <%= course.badge %>
                  </span>
                <% } %>
              </div>
              <div class="p-4 d-flex flex-column flex-grow-1">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge bg-primary bg-opacity-10 text-primary small px-2 py-1 rounded-pill">
                    <%= course.category %>
                  </span>
                  <span class="small text-muted"><i class="fa-solid fa-signal me-1"></i><%= course.level %></span>
                </div>
                <h5 class="fw-bold mb-2">
                  <a href="/courses/<%= course.id %>" class="text-dark text-decoration-none text-truncate d-block">
                    <%= course.title %>
                  </a>
                </h5>
                <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= course.subtitle %>
                </p>
                <div class="d-flex align-items-center gap-2 mb-3 small">
                  <span class="rating-stars">
                    <i class="fa-solid fa-star"></i>
                    <strong class="text-dark ms-1"><%= course.rating || 4.9 %></strong>
                  </span>
                  <span class="text-muted">(<%= course.reviewsCount || 100 %>)</span>
                  <span class="ms-auto text-secondary"><i class="fa-regular fa-clock me-1"></i><%= course.duration %></span>
                </div>
                <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top flex-wrap gap-2">
                  <div>
                    <span class="price-tag fs-4 fw-bold text-success">৳<%= Number(course.price).toLocaleString('en-IN') %></span>
                    <% if (course.originalPrice && course.originalPrice > course.price) { %>
                      <span class="original-price-tag text-muted text-decoration-line-through small ms-1">৳<%= Number(course.originalPrice).toLocaleString('en-IN') %></span>
                      <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 ms-1 small">
                        <%= Math.round((1 - course.price/course.originalPrice)*100) %>% ছাড়
                      </span>
                    <% } %>
                  </div>
                  <a href="/courses/<%= course.id %>" class="btn btn-primary-custom btn-sm">
                    কোর্স দেখুন
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </section>

  <!-- Featured Articles -->
  <section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h3 fw-bold mb-1">Latest Tech Articles & Tutorials</h2>
        <p class="text-muted mb-0">Free deep-dives and guides written by developers</p>
      </div>
      <a href="/articles" class="btn btn-outline-primary btn-sm">
        View All <i class="fa-solid fa-arrow-right ms-1"></i>
      </a>
    </div>

    <div class="row g-4">
      <% if (articles && articles.length > 0) { %>
        <% articles.slice(0, 3).forEach(article => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card-custom">
              <div class="card-img-wrapper">
                <img
                  src="<%= article.featureImage || '/images/CONTENT.png' %>"
                  alt="<%= article.title %>"
                  onerror="this.src='/images/CONTENT.png'"
                />
              </div>
              <div class="card-body-custom">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge-category badge-cat-<%= (article.category || 'general').toLowerCase() %>">
                    <i class="fa-solid fa-tag"></i> <%= article.categoryName || article.category %>
                  </span>
                  <small class="text-muted"><i class="fa-regular fa-calendar me-1"></i><%= article.articleDate || 'Recent' %></small>
                </div>
                <h5 class="fw-bold mb-2 text-dark text-truncate"><%= article.title %></h5>
                <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= article.content %>
                </p>
                <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                  <small class="text-secondary fw-semibold"><i class="fa-regular fa-user me-1"></i><%= article.author || 'Sarfaraj Rahman' %></small>
                  <a href="/articles/<%= article.id %>" class="btn btn-sm btn-outline-primary">Read More</a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <p class="text-muted">No articles found. Be the first to create one!</p>
          <a href="/articles/add" class="btn btn-primary-custom">Add Article</a>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h3 fw-bold mb-1">Explore by Category</h2>
        <p class="text-muted mb-0">Browse through curated topics</p>
      </div>
      <a href="/categories" class="btn btn-outline-primary btn-sm">
        All Categories <i class="fa-solid fa-arrow-right ms-1"></i>
      </a>
    </div>

    <div class="row g-3">
      <% if (categories && categories.length > 0) { %>
        <% categories.forEach(category => { %>
          <div class="col-sm-6 col-lg-3">
            <div class="card p-3 border-0 shadow-sm h-100 hover-shadow transition">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3">
                  <i class="fa-solid fa-folder-open fa-lg"></i>
                </div>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                  <%= articles ? articles.filter(a => a.categoryId == category.id || a.category === category.name).length : 0 %> Posts
                </span>
              </div>
              <h6 class="fw-bold mb-1"><%= category.name %></h6>
              <p class="text-muted small mb-2"><%= category.description || 'Topic discussions and guides.' %></p>
              <a href="/articles?category=<%= encodeURIComponent(category.name) %>" class="stretched-link small text-primary fw-semibold text-decoration-none">
                Browse Category <i class="fa-solid fa-chevron-right ms-1"></i>
              </a>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
