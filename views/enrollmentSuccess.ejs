<%- include('partials/header', { title: 'Enrollment Confirmed!' }) %>
<%- include('partials/navbar', { page: 'courses' }) %>

<main class="container my-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="p-4 p-md-5 bg-white rounded-4 shadow-sm border my-3">
        <!-- Success Icon -->
        <div class="mb-3 text-success">
          <i class="fa-solid fa-circle-check fa-4x animate__animated animate__bounceIn"></i>
        </div>

        <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 rounded-pill fw-bold mb-2">
          Payment & Enrollment Verified
        </span>

        <h2 class="fw-bold mb-2">Congratulations, <%= enrollment.studentName %>!</h2>
        <p class="text-muted mb-4">
          You are officially enrolled in <strong><%= course.title %></strong>. A confirmation email with receipt and portal access credentials has been sent to <strong><%= enrollment.studentEmail %></strong>.
        </p>

        <!-- Receipt Box -->
        <div class="p-4 bg-light rounded-3 text-start mb-4 border">
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted small">Enrollment ID:</span>
            <strong class="font-monospace text-dark"><%= enrollment.id %></strong>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted small">Course:</span>
            <strong class="text-dark"><%= course.title %></strong>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted small">Payment Method:</span>
            <span><%= enrollment.paymentMethod %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted small">Date:</span>
            <span><%= enrollment.enrollmentDate %></span>
          </div>
          <hr class="my-2" />
          <div class="d-flex justify-content-between align-items-center">
            <span class="fw-bold">Total Paid:</span>
            <span class="fw-bold text-success fs-5">$<%= enrollment.amountPaid %> USD</span>
          </div>
        </div>

        <!-- Next Action Buttons -->
        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <a href="/courses/<%= course.id %>" class="btn btn-primary-custom px-4">
            <i class="fa-solid fa-play-circle me-1"></i> Access Course Syllabus
          </a>
          <a href="/courses" class="btn btn-outline-secondary px-4">
            Browse More Courses
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
