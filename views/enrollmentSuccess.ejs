<%- include('partials/header', { title: 'এনরোলমেন্ট সফল হয়েছে - DevAcademy' }) %>
<%- include('partials/navbar', { page: 'courses' }) %>

<main class="container my-4 my-md-5 text-center">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-7">
      <div class="p-4 p-md-5 bg-white rounded-4 shadow-sm border print-invoice-card">
        <!-- Success Icon -->
        <div class="mb-3 text-success">
          <i class="fa-solid fa-circle-check fa-4x animate__animated animate__bounceIn"></i>
        </div>

        <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 rounded-pill fw-bold mb-2">
          <i class="fa-solid fa-shield-check me-1"></i> পেমেন্ট ও এনরোলমেন্ট ভেরিফাইড
        </span>

        <h2 class="fw-bold mb-2">অভিনন্দন, <%= enrollment.studentName %>!</h2>
        <p class="text-muted mb-4">
          আপনি সফলভাবে <strong><%= course.title %></strong> কোর্সে এনরোল সম্পন্ন করেছেন। আপনার ইমেইল <strong><%= enrollment.studentEmail %></strong> ও মোবাইল নম্বরে ক্লাসরুম অ্যাক্সেস ও লগইন তথ্য পাঠানো হয়েছে।
        </p>

        <!-- Printable Invoice Receipt Box -->
        <div class="p-4 bg-light rounded-3 text-start mb-4 border">
          <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <span class="fw-bold text-dark small"><i class="fa-solid fa-receipt me-1 text-primary"></i> অফিসিয়াল পেমেন্ট রিসিট</span>
            <span class="badge bg-success">PAID / পরিশোধিত</span>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">অর্ডার / এনরোলমেন্ট আইডি:</span>
            <div class="d-flex align-items-center gap-1">
              <strong class="font-monospace text-dark"><%= enrollment.id %></strong>
              <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 btn-copy-clipboard no-print" onclick="copyReceiptText('<%= enrollment.id %>', this)" title="কপি করুন">
                <i class="fa-regular fa-copy"></i>
              </button>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">কোর্স শিরোনাম:</span>
            <strong class="text-dark text-truncate text-end ms-2" style="max-width: 280px;"><%= course.title %></strong>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">পেমেন্ট মেথড:</span>
            <span class="badge bg-secondary"><%= enrollment.paymentMethod %> (বাংলাদেশ)</span>
          </div>

          <% if (enrollment.trxId) { %>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="text-muted small">Transaction ID (TrxID):</span>
              <div class="d-flex align-items-center gap-1">
                <strong class="font-monospace text-primary"><%= enrollment.trxId %></strong>
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 btn-copy-clipboard no-print" onclick="copyReceiptText('<%= enrollment.trxId %>', this)" title="কপি করুন">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>
            </div>
          <% } %>

          <% if (enrollment.studentPhone) { %>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="text-muted small">শিক্ষার্থীর মোবাইল নম্বর:</span>
              <span>+88 <%= enrollment.studentPhone %></span>
            </div>
          <% } %>

          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">এনরোলমেন্টের তারিখ:</span>
            <span><%= enrollment.enrollmentDate %></span>
          </div>

          <hr class="my-3" />

          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="fw-bold d-block">পরিশোধিত মোট ফি:</span>
              <small class="text-muted">Bangladeshi Taka (BDT)</small>
            </div>
            <span class="fw-bold text-success fs-3">৳<%= Number(enrollment.amountPaid).toLocaleString('en-IN') %></span>
          </div>
        </div>

        <!-- Next Action Buttons -->
        <div class="d-flex flex-wrap gap-2 justify-content-center no-print">
          <a href="/courses/<%= course.id %>" class="btn btn-primary-custom px-4 py-2">
            <i class="fa-solid fa-play-circle me-1"></i> কোর্স ক্লাসরুমে যান
          </a>
          <button type="button" class="btn btn-outline-dark px-3 py-2" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i> রিসিট প্রিন্ট করুন
          </button>
          <a href="/courses" class="btn btn-outline-secondary px-3 py-2">
            সকল কোর্স দেখুন
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  function copyReceiptText(text, btn) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => {
        const originalHtml = btn.innerHTML;
        btn.classList.add('copied');
        btn.innerHTML = `<i class="fa-solid fa-check text-white"></i>`;
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = originalHtml;
        }, 2000);
      });
    }
  }
</script>

<%- include('partials/footer') %>
